# Copy to .env and fill in. .env is gitignored — the portal URL and MAC ARE the subscription.
# With Portainer you don't need this file at all; set these in the stack's Environment variables.

RELAY_PORTAL=http://line.example.net/portal.php
RELAY_MAC=00:1A:79:XX:XX:XX

# What your provider actually allows concurrently. The relay refuses politely at this number
# rather than letting the portal answer a bare 456 halfway through a film.
RELAY_MAX_CONNECTIONS=2

# Devices log in with the MAC above as username and this as password.
RELAY_PASSWORD=change-me

RELAY_PORT=4700
RELAY_TZ=Europe/London

# Optional external XMLTV. Leave empty to build a guide from the portal's own short-EPG.
RELAY_EPG_URL=
