# Copy to .env if you're using plain docker compose. With Portainer you don't need this file —
# set these under the stack's "Environment variables" instead. .env is gitignored.
#
# Lines are added in the dashboard now, not here.

# Password for the dashboard at http://host:4700
# Leave it blank and the relay generates one on first start and prints it to the container log.
RELAY_ADMIN_PASSWORD=

RELAY_PORT=4700

# Ports a line may claim for itself. Must match the range published in docker-compose.yml.
RELAY_PORT_MIN=4701
RELAY_PORT_MAX=4720

# Default timezone for new lines.
RELAY_TZ=Europe/London

# --- migration only -----------------------------------------------------------------------------
# Read ONCE, on a first run with no configuration, to import an existing single-line setup.
# Ignored afterwards. Leave blank on a fresh install and add the line in the dashboard.
RELAY_PORTAL=
RELAY_MAC=
RELAY_PASSWORD=
